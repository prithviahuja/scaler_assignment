# Copy to .env for local development. All values have working defaults.

# SQLite by default. On Render with a persistent disk mounted at /var/data use:
#   DATABASE_URL=sqlite+aiosqlite:////var/data/signal.db
DATABASE_URL=sqlite+aiosqlite:///./signal.db

# Change this in production — it signs the session tokens.
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=43200

# Verification is mocked; this is the code every account accepts.
MOCK_OTP_CODE=123456

# Comma-separated allowed origins, or * for all.
# In production set this to your Vercel URL, e.g. https://your-app.vercel.app
CORS_ORIGINS=*

# Load the demo users/conversations the first time the database is created.
SEED_ON_STARTUP=true

# Where uploaded attachments are written; served back from /uploads.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
